#. Plugin Name of the plugin
#: bank-transfer-payments-for-woocommerce.php
msgid "Bank Transfer Payments for WooCommerce"
msgstr ""

#. Description of the plugin
#: bank-transfer-payments-for-woocommerce.php
msgid "Accept reconciled bank transfer payments in WooCommerce via Stripe. Each order gets unique virtual bank account details (SEPA/ACH/Bacs/SPEI), and webhooks mark the order paid automatically."
msgstr "Akzeptiert automatisch abgeglichene Zahlungen per Banküberweisung in WooCommerce über Stripe. Jede Bestellung erhält eigene virtuelle Bankverbindungsdaten (SEPA/ACH/Bacs/SPEI), und Webhooks markieren die Bestellung automatisch als bezahlt."

#: bank-transfer-payments-for-woocommerce.php:64
msgid "Bank Transfer Payments for WooCommerce requires WooCommerce to be installed and activated."
msgstr "Bank Transfer Payments for WooCommerce erfordert, dass WooCommerce installiert und aktiviert ist."

